+    }
+
+    private function render(string $view, string $title, array $data = [], ?string $records = null): View
+    {
+        return view()->exists($view)
+            ? view($view, $data)
+            : view('admin.placeholder', array_merge([
+                'pageTitle' => $title,
+                'records'   => $records,
+            ], $data));
+    }
+}
